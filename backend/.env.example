# Base de données (fournie par Supabase : Project Settings > Database > Connection string)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# JWT (générer une chaîne aléatoire longue, ex: openssl rand -base64 32)
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"

# Cloudinary (Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Port du serveur
PORT=3001

# URL du frontend (pour la config CORS)
FRONTEND_URL="http://localhost:3002"

# Paiement — mise en avant des annonces (section 17-18 du cahier des charges)
# Laisse tout vide pour rester en mode démo (utilise POST /payments/:orderId/simulate pour tester)

# Wave Business (https://business.wave.com/dev-portal) — API officielle, intégration directe
WAVE_API_KEY=""
# Secret webhook généré dans Wave Business Portal > Developer > Webhooks (Signing Secret recommandé)
WAVE_WEBHOOK_SECRET=""

# PayDunya (https://paydunya.com) — agrégateur sénégalais couvrant Orange Money, Wave, Free Money
# et cartes en une seule API. C'est la voie recommandée pour Orange Money : il n'existe pas d'API
# self-service publique pour s'y connecter directement.
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
# "test" (sandbox, par défaut) ou "live" une fois le compte validé par PayDunya
PAYDUNYA_MODE="test"
